# Supabase usado pelo app (a publishable key pode ir ao navegador).
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA_AQUI

# Bootstrap e operações administrativas executadas somente no servidor/CLI.
# Nunca adicione NEXT_PUBLIC_ a estas variáveis e nunca versione valores reais.
# E-mail e senha do primeiro admin não ficam neste arquivo; o script os solicita.
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_SUBSTITUA_AQUI

# Cloudflare Stream. Use apenas no servidor.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_CODE=
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_JWK=
# Domínios onde o player é autorizado, separados por vírgula e sem protocolo.
CLOUDFLARE_STREAM_ALLOWED_ORIGINS=
CLOUDFLARE_STREAM_MAX_DURATION_SECONDS=14400
